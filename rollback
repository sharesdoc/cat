#!/usr/bin/env bash
#
# Cat MCP Server — 回滚脚本
# 从备份恢复数据库和版本
# 依据: CAT-35
#
# 使用方式：
#   ./rollback --backup /opt/cat-mcp/backups/pre-YYYYMMDDHHMMSS
#   ./rollback --prefix=/opt --backup /opt/cat-mcp/backups/pre-YYYYMMDDHHMMSS

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OS="$(uname -s)"

if [ "$#" -eq 0 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'HELP'
用法: ./rollback --backup=<备份目录> [选项]

从备份恢复 Cat MCP 服务器。恢复数据库和版本文件，不影响配置文件。

必选：
  --backup=PATH     备份目录路径（如 /opt/cat-mcp/backups/pre-20261127120000）

选项：
  --prefix=PATH     指定安装前缀（默认 /opt/cat-mcp 或 ~/.local/opt/cat-mcp）
  --no-restart      不回滚后重启服务
  --help            显示本帮助

示例：
  ./rollback --backup /opt/cat-mcp/backups/pre-20261127120000
HELP
    exit 0
fi

PREFIX=""
BACKUP_DIR=""
NO_RESTART=false

for arg in "$@"; do
    case "$arg" in
        --prefix=*) PREFIX="${arg#*=}" ;;
        --backup=*) BACKUP_DIR="${arg#*=}" ;;
        --no-restart) NO_RESTART=true ;;
        *) echo "未知选项: $arg" >&2; exit 1 ;;
    esac
done

if [ -z "$BACKUP_DIR" ]; then
    echo "错误: --backup 参数必填" >&2
    exit 1
fi

if [ ! -d "$BACKUP_DIR" ]; then
    echo "错误: 备份目录不存在: $BACKUP_DIR" >&2
    exit 1
fi

if [ -z "$PREFIX" ]; then
    if [ "$OS" = "Linux" ]; then
        PREFIX="/opt/cat-mcp"
    else
        PREFIX="$HOME/.local/opt/cat-mcp"
    fi
fi

DATA_DIR="/var/lib/cat"
CONFIG_DIR="/etc/cat"
if [ "$OS" != "Linux" ]; then
    DATA_DIR="$PREFIX/var"
    CONFIG_DIR="$PREFIX/etc"
fi

echo "Cat MCP Server 回滚程序"
echo "========================================"
echo "  备份目录: $BACKUP_DIR"
echo "  安装路径: $PREFIX"
echo ""

# ---- 验证备份 ----
if [ ! -f "$BACKUP_DIR/VERSION" ]; then
    echo "错误: 备份不完整（缺少 VERSION）" >&2
    exit 1
fi

BACKUP_VERSION="$(cat "$BACKUP_DIR/VERSION")"
echo "  恢复到版本: v${BACKUP_VERSION}"

# ---- 停止服务（恢复前必须停止，防止 WAL 损坏） ----
if [ "$OS" = "Linux" ]; then
    echo "[1/3] 停止 cat-mcp 服务..."
    sudo systemctl stop cat-mcp 2>/dev/null || true
fi

# ---- 恢复数据库 ----
echo "[2/3] 恢复数据库..."
if [ -f "$BACKUP_DIR/state.db" ]; then
    cp "$BACKUP_DIR/state.db" "$DATA_DIR/state.db"
    echo "  数据库已恢复"
else
    echo "  备份中无数据库文件，跳过"
fi

# 恢复版本记录
cp "$BACKUP_DIR/VERSION" "$PREFIX/VERSION"
echo "  版本记录已恢复"

# ---- 重启服务 ----
if [ "$NO_RESTART" = false ] && [ "$OS" = "Linux" ]; then
    echo "[3/3] 重启服务..."
    systemctl start cat-mcp 2>/dev/null || true
    systemctl status cat-mcp --no-pager 2>/dev/null || true
    echo "  服务已重启"
else
    echo "[3/3] 跳过服务重启"
fi

# ---- 完成 ----
echo ""
echo "回滚完成!"
echo "========================================"
echo "  当前版本: v$(cat "$PREFIX/VERSION")"
echo "  配置文件 ($CONFIG_DIR) 不变"
echo ""
if [ "$OS" = "Linux" ]; then
    echo "检查状态: systemctl status cat-mcp"
    echo "查看日志: journalctl -u cat-mcp -f"
fi
echo ""
