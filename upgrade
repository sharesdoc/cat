#!/usr/bin/env bash
#
# Cat MCP Server — 升级脚本
# 保留配置和数据库，仅更新代码
# 依据: CAT-35
#
# 使用方式：
#   ./upgrade                   # 升级到最新版本
#   ./upgrade --prefix=/opt     # 指定安装前缀
#   ./upgrade --help            # 显示帮助

set -euo pipefail

VERSION="1.0.0"
PYTHON="${PYTHON:-python3}"
PIP="${PIP:-pip3}"

# ---- 确定安装路径 ----
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OS="$(uname -s)"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'HELP'
用法: ./upgrade [选项]

升级 Cat MCP 服务器到最新版本。保留配置和数据文件。

选项：
  --prefix=PATH    指定安装前缀（默认 /opt/cat-mcp 或 ~/.local/opt/cat-mcp）
  --help           显示本帮助
HELP
    exit 0
fi

PREFIX=""
for arg in "$@"; do
    case "$arg" in
        --prefix=*) PREFIX="${arg#*=}" ;;
        --help|-h) ;; # already handled
        *) echo "未知选项: $arg" >&2; exit 1 ;;
    esac
done

if [ -z "$PREFIX" ]; then
    if [ "$OS" = "Linux" ]; then
        PREFIX="/opt/cat-mcp"
    else
        PREFIX="$HOME/.local/opt/cat-mcp"
    fi
fi

# ---- 检查安装 ----
if [ ! -f "$PREFIX/VERSION" ]; then
    echo "错误: 未检测到 $PREFIX 中的 Cat 安装。" >&2
    echo "请先运行 ./install。" >&2
    exit 1
fi

OLD_VERSION="$(cat "$PREFIX/VERSION")"
DATA_DIR="/var/lib/cat"
CONFIG_DIR="/etc/cat"

if [ "$OS" != "Linux" ]; then
    DATA_DIR="$PREFIX/var"
    CONFIG_DIR="$PREFIX/etc"
fi

echo "Cat MCP Server 升级程序"
echo "========================================"
echo "  当前版本: v${OLD_VERSION}"
echo "  升级目标: v${VERSION}"
echo "  安装路径: $PREFIX"
echo ""

# ---- 备份当前版本 ----
echo "[1/4] 备份当前版本..."
BACKUP_DIR="$PREFIX/backups/pre-$(date +%Y%m%d%H%M%S)"
mkdir -p "$BACKUP_DIR"
cp "$PREFIX/VERSION" "$BACKUP_DIR/VERSION" 2>/dev/null || true

# 备份数据库
if [ -f "$DATA_DIR/state.db" ]; then
    echo "  备份数据库..."
    "$PYTHON" -c "
import sqlite3
src = '$DATA_DIR/state.db'
dst = '$BACKUP_DIR/state.db'
try:
    con = sqlite3.connect(src)
    bck = sqlite3.connect(dst)
    con.backup(bck)
    bck.close()
    con.close()
    print('  数据库备份完成')
except Exception as e:
    print(f'  数据库备份失败（跳过）: {e}')
" 2>/dev/null || echo "  数据库备份失败（跳过）"
fi

# ---- 更新代码 ----
echo "[2/4] 更新代码..."
cd "$SCRIPT_DIR"

if command -v uv &>/dev/null; then
    echo "  使用 uv 更新..."
    uv pip install --system -e . 2>/dev/null || \
        uv pip install -e .
else
    echo "  使用 pip 更新..."
    $PIP install --no-cache-dir -e .
fi

# ---- 更新版本记录 ----
echo "[3/4] 更新版本记录..."
echo "$VERSION" > "$PREFIX/VERSION"
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$PREFIX/INSTALL_TIME"

# ---- 重启服务 ----
echo "[4/4] 重启服务..."
if [ "$OS" = "Linux" ] && systemctl is-active --quiet cat-mcp 2>/dev/null; then
    echo "  重启 cat-mcp 服务..."
    systemctl restart cat-mcp 2>/dev/null || echo "  重启失败，请手动执行: sudo systemctl restart cat-mcp"
    systemctl status cat-mcp --no-pager 2>/dev/null || true
elif [ "$OS" = "Linux" ] && [ -f "/etc/systemd/system/cat-mcp.service" ]; then
    echo "  服务未运行，跳过重启。使用: sudo systemctl start cat-mcp"
else
    echo "  非 systemd 环境，请手动重启 Cat 进程"
fi

# ---- 完成 ----
echo ""
echo "升级完成!"
echo "========================================"
echo "  v${OLD_VERSION} → v${VERSION}"
echo "  备份: $BACKUP_DIR"
echo "  配置和数据文件保持不变"
echo ""
echo "如需回滚: ./rollback --backup $BACKUP_DIR"
echo ""
